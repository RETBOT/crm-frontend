# Secret key for client-side encryption (min 32 hex chars)
VITE_SECRET_KEY=<generate_with_crypto>

# API URL (relative for dev proxy, full URL for production)
VITE_API_URL="/api/"

# Server route prefix (empty for root, "/crm" for subpath)
VITE_RUTA_SERVER=""

# Image path
VITE_RUTA_IMAGEN="/src"

# Token refresh interval in minutes
VITE_TIME_REFRESH=10
